want_ospool = true

container_image = WISC_MVPA.sif
transfer_container = false

executable = ./shared/run_WISC_MVPA_Apptainer.sh
arguments = $(data) $(metadata)

max_idle = 2000

initialdir = ./$(jobdir)
output = ../log/tune_$(jobdir).out
error = ../log/tune_$(jobdir).err
log = ../log/tune_$(jobdir).log

requirements = (BackfillSlot =!= true) && HasCommonFilesTransfer

request_cpus = 1
request_memory = 12GB
request_disk = 16GB

should_transfer_files = YES
transfer_input_files = ./,../shared/,$(data),$(metadata)
MY.CommonInputFiles = "osfd:///chtc/staging/sfrisby/WISC_MVPA.sif"

queue jobdir,data,metadata from queue_input.csv

